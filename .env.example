XAI_API_KEY=your-xai-api-key-here

# Embedding Service (Railway - nomic-embed-text)
EMBEDDING_URL=https://your-nomic-embed-text.up.railway.app

# Translation API (LibreTranslate)
LIBRETRANSLATE_URL=https://your-libretranslate.up.railway.app
