DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:<PORT>/railway
JWT_SECRET=your-secret-key-here

# RAG Database (pgvector)
RAG_DATABASE_URL=postgres://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB_NAME>

# AI Services
